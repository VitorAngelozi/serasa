//aqui refere-se a parte de clicar em salvar. vai fazer as
//verificacoes de cada edit.
procedure TfrmCadastro.SalvarClick(Sender: TObject);

 var
        I: Integer;
        CpfFormatado: string;
        DataNascimentoFormatado: string;
begin


//basicao, apenas conferindo se sem espaco ele tem mais q 2 caracteres
      if Length(Trim(edtNome.text)) < 2 then
      begin
        Application.MessageBox(
        'Preencha o nome com ao menos 2 caracteres',
        'Nome invalido',
        MB_OK + MB_ICONWARNING
        );

        edtNome.SetFocus;
        Exit;

      end;

//basicao, apenas conferindo se sem espaco ele tem mais q 2 caractere
      if Length(Trim(edtSobrenome.text)) < 2 then
      begin
        Application.MessageBox(
        'Preencha o sobrenome com ao menos 2 caracteres',
        'Nome invalido',
        MB_OK + MB_ICONWARNING
        );

        edtSobrenome.SetFocus;
        Exit;

      end;
//validacao em cpf para ter 11 caracteres


      if Length(Trim(edtCPF.Text)) <> 11 then
      begin
        Application.MessageBox(
        'Preencha com a quantidade correta de 11 caracteres',
        'CPF invalido',
        MB_OK + MB_ICONWARNING

        );
        edtCpf.SetFocus;
        Exit;

      end;

//aq a cada 3 adiciona o .
        CpfFormatado := '';
        for I := 1 to 11 do
        begin

          CpfFormatado := CpfFormatado + edtCpf.Text[I];

          if (I = 3) or (I = 6) then
          CpfFormatado := CpfFormatado + '.';

          if I = 9 then
          CpfFormatado := CpfFormatado + '-';

        end;

        edtCpf.Text := CpfFormatado;


      //logica para ´validar e formatar data de nascimento
      if Length(Trim(edtDataNascimento.Text)) <> 8 then
      begin
        Application.MessageBox(
        'Data invalida!',
        'Data invalida',
         MB_OK + MB_ICONWARNING
        );

        edtDatanascimento.SetFocus;
        Exit;
      end;

      DataNascimentoFormatado := '';
      for I := 1 to 8 do
        begin
          DataNascimentoFormatado := DataNascimentoFormatado +
          edtDataNascimento.Text[I];
          if (I=2) or (I=4) or (I=6) then
          DataNascimentoFormatado := DataNascimentoFormatado + '/';

        end;

        edtDataNascimento.Text := DataNascimentoFormatado;



      end;





end.
