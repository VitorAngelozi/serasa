unit UnitCadastro;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs,
  Vcl.StdCtrls, Vcl.Mask, Vcl.ToolWin, Vcl.ActnMan, Vcl.ActnCtrls,
  Vcl.ActnMenus;

type
  TfrmCadastro = class(TForm)
    Label1: TLabel;
    Label2: TLabel;
    edtNome: TEdit;
    Label3: TLabel;
    edtSobrenome: TEdit;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    Label7: TLabel;
    btnLimpar: TButton;
    btnSalvar: TButton;
    mskCpf: TMaskEdit;
    mskDataNascimento: TMaskEdit;
    mskCep: TMaskEdit;
    edtEndereco: TEdit;
    procedure btnSalvarClick(Sender: TObject);
    procedure btnLimparClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  frmCadastro: TfrmCadastro;

implementation

{$R *.dfm}

procedure TfrmCadastro.btnLimparClick(Sender: TObject);
begin
  edtNome.Clear;
  edtSobrenome.Clear;
  mskCpf.Clear;
  mskDataNascimento.Clear;
  mskCep.Clear;
  edtEndereco.Clear;

  edtNome.SetFocus;
end;

procedure TfrmCadastro.btnSalvarClick(Sender: TObject);
var
  LDataValida: TDateTime;
  LCpfNumerico: string;
  LCepNumerico: string;
begin
  // Nome
  if Length(Trim(edtNome.Text)) < 2 then
  begin
    Application.MessageBox(
      'Preencha o nome com ao menos 2 caracteres',
      'Nome invalido',
      MB_OK + MB_ICONINFORMATION
    );

    edtNome.SetFocus;
    Exit;
  end;

  // Sobrenome
  if Length(Trim(edtSobrenome.Text)) < 2 then
  begin
    Application.MessageBox(
      'Preencha o sobrenome com ao menos 2 caracteres',
      'Sobrenome invalido',
      MB_OK + MB_ICONINFORMATION
    );

    edtSobrenome.SetFocus;
    Exit;
  end;

  // CPF
  LCpfNumerico := StringReplace(mskCpf.Text, '.', '', [rfReplaceAll]);
  LCpfNumerico := StringReplace(LCpfNumerico, '-', '', [rfReplaceAll]);
  LCpfNumerico := Trim(LCpfNumerico);

  if Length(LCpfNumerico) <> 11 then
  begin
    Application.MessageBox(
      'Preencha o CPF corretamente',
      'CPF invalido',
      MB_OK + MB_ICONINFORMATION
    );

    mskCpf.SetFocus;
    Exit;
  end;

  // Data de nascimento
  if not TryStrToDate(mskDataNascimento.Text, LDataValida) then
  begin
    Application.MessageBox(
      'Digite uma data valida',
      'Data invalida',
      MB_OK + MB_ICONINFORMATION
    );

    mskDataNascimento.SetFocus;
    Exit;
  end;

  // CEP
  LCepNumerico := StringReplace(mskCep.Text, '-', '', [rfReplaceAll]);
  LCepNumerico := Trim(LCepNumerico);

  if Length(LCepNumerico) <> 8 then
  begin
    Application.MessageBox(
      'Preencha o CEP corretamente',
      'CEP invalido',
      MB_OK + MB_ICONINFORMATION
    );

    mskCep.SetFocus;
    Exit;
  end;

  // Endereco
  if Length(Trim(edtEndereco.Text)) < 2 then
  begin
    Application.MessageBox(
      'Preencha o endereco',
      'Endereco invalido',
      MB_OK + MB_ICONINFORMATION
    );

    edtEndereco.SetFocus;
    Exit;
  end;

  Application.MessageBox(
    'Todos os dados estao validos',
    'Cadastro',
    MB_OK + MB_ICONINFORMATION
  );
end;

end.
